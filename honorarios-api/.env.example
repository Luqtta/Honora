# Producao / Railway. Credenciais embutidas na URL (user/password como query params).
DATABASE_URL=jdbc:postgresql://HOST:PORT/DBNAME?user=USUARIO&password=SENHA
JWT_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_EXPIRATION=86400000
# URL do frontend em producao (Railway/Vercel/etc). Varias separadas por virgula.
CORS_ORIGIN=https://seu-frontend.com
