# Producao / Railway. Usuario e senha separados (robusto a caracteres especiais).
DATABASE_URL=jdbc:postgresql://HOST:PORT/DBNAME
DATABASE_USERNAME=usuario
DATABASE_PASSWORD=senha
JWT_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_EXPIRATION=86400000
# URL do frontend em producao (Railway/Vercel/etc). Varias separadas por virgula.
CORS_ORIGIN=https://seu-frontend.com
