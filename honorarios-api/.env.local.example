# Postgres do docker-compose
POSTGRES_DB=honora
POSTGRES_USER=honora
POSTGRES_PASSWORD=honora

# App apontando pro Postgres do Docker (mesmo padrao do Railway, so muda o valor)
DATABASE_URL=jdbc:postgresql://localhost:5432/honora?user=honora&password=honora
JWT_SECRET=dev-secret-change-me-in-production-min-32-bytes-long-0123456789
JWT_EXPIRATION=86400000
CORS_ORIGIN=http://localhost:5173
